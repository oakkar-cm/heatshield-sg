JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGINS="http://localhost:3000,https://heatshieldsg.vercel.app"
FRONTEND_URL="https://heatshieldsg.vercel.app"
ADMIN_EMAIL="admin@heatshield.sg"
ADMIN_PASSWORD="change-me"
GROQ_API_KEY="gsk_your_groq_key"
GROQ_MODEL="llama-3.1-8b-instant"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CLAIMS_EMAIL="mailto:alerts@heatshield.sg"
SQLITE_PATH="data/heatshield.db"

# Shared DB for multi-user on Vercel (free at https://turso.tech)
# Required in production — without these, each serverless instance has its own empty SQLite.
TURSO_DATABASE_URL="libsql://YOUR-DB-NAME-ORG.turso.io"
TURSO_AUTH_TOKEN=""
